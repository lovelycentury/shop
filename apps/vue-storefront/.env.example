# URL of the Medusa backend API server
NUXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000

# Publishable API key of the sales channel this storefront sells through.
# Admin → Settings → Publishable API Keys
# https://docs.medusajs.com/resources/storefront-development/publishable-api-keys
NUXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=
